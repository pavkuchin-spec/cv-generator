{
  "name": "cv-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Agentic on-demand CV tailoring: renders a strict one-pager + long-form appendix PDF from YAML/Markdown sources.",
  "scripts": {
    "build": "node build.mjs",
    "demo": "node build.mjs _base --workspace examples/software-engineer",
    "demo:tailored": "node build.mjs exampleworks-senior-backend-engineer --workspace examples/software-engineer",
    "demo:radar": "node scripts/ingest.mjs --replay-only --workspace examples/software-engineer",
    "init": "node scripts/init-workspace.mjs",
    "rebuild": "node scripts/rebuild.mjs",
    "test": "node --test",
    "audit:public": "node scripts/privacy-audit.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.3.2",
    "marked": "^12.0.0",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^25.11.0"
  }
}
